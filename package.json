{
  "name": "polygraph-viz",
  "version": "0.4.0-pre",
  "description": "Browser-based graph visualizer for PolyGraph \u2014 see your data",
  "author": "William Fredricks",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/wfredricks/polygraph-viz.git"
  },
  "homepage": "https://github.com/wfredricks/polygraph-viz#readme",
  "bugs": {
    "url": "https://github.com/wfredricks/polygraph-viz/issues"
  },
  "keywords": [
    "graph",
    "visualizer",
    "graph-database",
    "d3",
    "force-directed",
    "polygraph",
    "knowledge-graph",
    "explorer"
  ],
  "bin": {
    "polygraph-viz": "dist/cli.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    }
  },
  "files": [
    "dist",
    "public/index.html",
    "public/styles.css",
    "public/client.js",
    "LICENSE",
    "README.md",
    "scripts"
  ],
  "scripts": {
    "dev": "npx tsx src/cli.ts",
    "dev:demo": "npx tsx src/cli.ts --demo",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsup src/cli.ts src/index.ts src/middleware.ts src/server.ts --format esm --dts",
    "build:client": "tsup --config tsup.client.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clone:ilabs": "node scripts/clone-ilabs.mjs",
    "clone:ilabs:confirm": "node scripts/clone-ilabs.mjs --confirm"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1050.0",
    "@hono/node-server": "^2.0.1",
    "d3-array": "^3.2.4",
    "d3-chord": "^3.0.1",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "hono": "^4.12.18",
    "polygraph-db": "file:../polygraph"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-chord": "^3.0.6",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-selection": "^3.0.10",
    "@types/d3-shape": "^3.1.6",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^25.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
