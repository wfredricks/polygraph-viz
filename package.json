{
  "name": "polygraph-viz",
  "version": "0.1.0",
  "description": "Browser-based graph visualizer for PolyGraph — see your data",
  "author": "William Fredricks",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/wfredricks/polygraph-viz.git"
  },
  "homepage": "https://github.com/wfredricks/polygraph-viz#readme",
  "bugs": {
    "url": "https://github.com/wfredricks/polygraph-viz/issues"
  },
  "keywords": [
    "graph",
    "visualizer",
    "graph-database",
    "d3",
    "force-directed",
    "polygraph",
    "knowledge-graph",
    "explorer"
  ],
  "bin": {
    "polygraph-viz": "dist/cli.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    }
  },
  "files": [
    "dist",
    "public",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "npx tsx src/server.ts",
    "build": "tsup src/cli.ts src/index.ts src/middleware.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "hono": "^4.12.18",
    "polygraph-db": "file:../polygraph"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "d3": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
